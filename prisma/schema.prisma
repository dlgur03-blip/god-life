datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  credits       Float     @default(100) // 첫 가입 100크레딧 무료
  geminiApiKey  String?   // 개인 API 키 (BYOK)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destinyDays       DestinyDay[]
  destinyEvents     DestinyEvent[]
  destinyTemplates  DestinyTemplate[]
  successProjects   SuccessProject[]
  disciplineRules   DisciplineRule[]
  epistleDays       EpistleDay[]
  weeklyPlans       WeeklyPlan[]
  errorLogs         ErrorLog[]
  goals             Goal[]
  transactions      MoneyTransaction[]
  chatSessions      ChatSession[]
  creditLogs        CreditLog[]
  onboarding        UserOnboarding?
  memos             Memo[]
  tasks             UserTask[]
  taskProjects      TaskProject[]
}

// M3: Destiny Navigator
model DestinyDay {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Long-term Perspective (장기관점) - 10 stages
  goalUltimate   String?  // 궁극의 나
  goal10Year     String?  // 10년 후의 나
  goal5Year      String?  // 5년 후의 나
  goal3Year      String?  // 3년 후의 나
  goal1Year      String?  // 1년 후의 나
  goal6Month     String?  // 6개월 후의 나
  goal3Month     String?  // 3개월 후의 나
  goal1Month     String?  // 1개월 후의 나
  goal2Week      String?  // 2주 후의 나
  goal1Week      String?  // 1주 후의 나
  goalToday      String?  // 오늘의 목표
  habitToKeep    String?  // 목표 달성을 위해 반드시 필요한 습관
  habitToRemove  String?  // 반드시 없애야 하는 습관
  restTime       String?  // 휴식 시간 배정

  // Legacy fields (keeping for migration compatibility)
  goalLong       String?
  goalMonth      String?
  goalWeek       String?

  timeblocks DestinyTimeBlock[]
  events     DestinyEvent[] // Events linked to a day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model DestinyTimeBlock {
  id            String     @id @default(cuid())
  dayId         String
  day           DestinyDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  seq           Int        // Now supports 1..N (no upper limit)
  startTime     String     @default("00:00")  // REQUIRED - no longer optional
  endTime       String     @default("01:00")  // REQUIRED - no longer optional

  planText      String?
  planLocation  String?

  actualText    String?
  score         Int?       // 0..10
  feedback      String?

  status        String     @default("planned")

  updatedAt     DateTime   @updatedAt

  @@unique([dayId, seq])
}

// Destiny Timeblock Templates
model DestinyTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   // Template name (e.g., 'Weekday Routine', 'Weekend Routine')
  blocks    Json     // Array of {seq, startTime, endTime, planText, planLocation}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// M4: Events
model DestinyEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId       String?
  day         DestinyDay? @relation(fields: [dayId], references: [id])

  title       String
  recordedAt  DateTime @default(now())
  
  createdAt   DateTime @default(now())
}

// M5: Success Code
model SuccessProject {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title        String
  startDate    DateTime
  reminderTime String?  // "09:00"
  enabled      Boolean  @default(true)

  entries      SuccessEntry[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SuccessEntry {
  id          String         @id @default(cuid())
  projectId   String
  project     SuccessProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dayIndex    Int            // 1..100
  content     String?
  imageUrl    String?        // M6
  
  isCompleted Boolean        @default(false)
  completedAt DateTime?

  updatedAt   DateTime       @updatedAt

  @@unique([projectId, dayIndex])
}

// M7: Discipline Mastery
model DisciplineRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  sortOrder Int      @default(0)

  checks    DisciplineCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisciplineCheck {
  id        String         @id @default(cuid())
  ruleId    String
  rule      DisciplineRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  date      String         // YYYY-MM-DD
  checkedAt DateTime       @default(now())

  @@unique([ruleId, date])
}

// M8: Self Epistle
model EpistleDay {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String   // YYYY-MM-DD
  toYesterday String?  // Letter to yesterday (legacy, free-form)
  toTomorrow  String?  // Letter to tomorrow (legacy, free-form)
  mood        String?

  // Fixed fields for toYesterday (어제의 나에게)
  gratitude1    String?  // 고마운 일 1
  gratitude2    String?  // 고마운 일 2
  gratitude3    String?  // 고마운 일 3
  important1    String?  // 중요한 일 1
  important2    String?  // 중요한 일 2
  important3    String?  // 중요한 일 3
  anger         String?  // 분노하는 한가지
  leisure1      String?  // 여가활동 1
  leisure2      String?  // 여가활동 2
  leisure3      String?  // 여가활동 3

  // Fixed fields for toTomorrow (내일의 나에게)
  reflection1   String?  // 반성하는 것 1
  reflection2   String?  // 반성하는 것 2
  reflection3   String?  // 반성하는 것 3

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
}

// Weekly Plan - 7 free-form slots
model WeeklyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  slot      Int      // 0-6 (7 slots)
  content   String   // Free-form content

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slot])
}

// M9: Bio Hacking (Global Content with Translations)
model BioPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  category  String

  translations BioPostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BioPostTranslation {
  id        String   @id @default(cuid())
  postId    String
  post      BioPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  locale    String   // 'ko' | 'en' | 'ja'
  title     String
  content   String   // Markdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, locale])
}

// Error Logging
model ErrorLog {
  id            String   @id @default(cuid())
  level         String   // 'error' | 'warning' | 'info'
  message       String
  stack         String?  // Max 5000 chars (truncated on save)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestUrl    String?
  requestMethod String?
  createdAt     DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([userId])
}

// Goal Type Enum
enum GoalType {
  ULTIMATE    // 궁극의 목표
  TEN_YEAR    // 10년 목표
  FIVE_YEAR   // 5년 목표
  ONE_YEAR    // 1년 목표
  SIX_MONTH   // 6개월 목표
  THREE_MONTH // 3개월 목표
  ONE_MONTH   // 1개월 목표
  ONE_WEEK    // 1주 목표
}

// Goal Status Enum
enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

// Goal Model with self-referential hierarchy
model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        GoalType
  title       String
  description String?

  // Self-referential hierarchy
  parentId    String?
  parent      Goal?      @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]     @relation("GoalHierarchy")

  // Dates
  startDate   DateTime?
  targetDate  DateTime?

  // Progress tracking (0-100)
  progress    Int        @default(0)
  status      GoalStatus @default(ACTIVE)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([parentId])
}

// MET: Motivation Engine Type (동기원형검사)
model MetResult {
  id               String   @id @default(cuid())
  locale           String
  answers          Json     // [{questionId, answer, value}]
  result           Json     // Gemini full response
  archetypeName    String   // e.g. "고요한 건축가"
  archetypeEmoji   String   // OG card emoji
  summaryShort     String   // 1-line summary (OG card)
  scoreApproach    Int      @default(50)
  scoreAvoidance   Int      @default(50)
  scoreIntrinsic   Int      @default(50)
  scoreExtrinsic   Int      @default(50)
  scoreAchievement Int      @default(50)
  scoreAffiliation Int      @default(50)
  scorePower       Int      @default(50)
  scoreAutonomy    Int      @default(50)
  scoreCompetence  Int      @default(50)
  userId           String?  // optional logged-in user
  ipHash           String?  // rate limit hash
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Credit System
model CreditLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Float    // negative = used, positive = granted
  balance       Float    // balance after this transaction
  reason        String   // 'chat', 'met', 'signup_bonus', etc.
  inputTokens   Int?     // Gemini input tokens
  outputTokens  Int?     // Gemini output tokens
  model         String?  // model used

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// AI Coach Chat
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("New Chat")
  messages  ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      String      // 'user' | 'assistant' | 'system'
  content   String
  action    Json?       // {module, type, data} — auto-fill action performed

  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// Quick Memo (AI auto-tagged)
model Memo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  tags      Json?    // ["work", "idea", "todo"] etc.
  date      String   // YYYY-MM-DD
  time      String   // HH:MM
  reviewed  Boolean  @default(false) // AI가 피드백 시간에 정리했는지

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Task Project (프로젝트 폴더)
model TaskProject {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  emoji       String    @default("📁")
  color       String    @default("#2563eb") // hex color
  sortOrder   Int       @default(0)

  tasks       UserTask[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Task Board (작업 보드) — 시작 전 / 진행중 / 완료
model UserTask {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  status        String    @default("not_started") // not_started, in_progress, completed
  category      String?   // legacy grouping tag
  projectId     String?   // link to TaskProject
  project       TaskProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledTime String?   // HH:MM format — 예정 시간
  dueDate       String?   // YYYY-MM-DD — 마감일
  completedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([projectId])
}

// User Onboarding (AI priority system)
model UserOnboarding {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  metResultId     String?  // link to MET result
  availableTime   String?  // '15min' | '30min' | '1hour' | '2hour+'
  habitExperience String?  // 'none' | 'some' | 'many'
  focusAreas      Json?    // ['goals','habits','finance','health','emotion','time']
  chronotype      String?  // 'morning' | 'evening'
  preferredStyle  String?  // 'self' | 'ai-guided'
  executionLevel  Int      @default(1) // 1-5

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// M11: Tomorrow Signal (투모로우시그널)
model NewsSignal {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD (수집 날짜)
  category    String   // global_economy, tech_ai, geopolitics, energy, industry, health_bio, real_estate, life_trends + stock_*
  title       String   // AI 요약 제목
  summary     String   // AI 요약 본문
  regions     Json     // ["KR","US","CN","JP","GB","ME"] 보도된 지역 목록
  regionCount Int      // 몇 개 지역에서 보도됐는지
  sources     Json     // [{region, title, url}] 원본 뉴스 소스
  importance  Int      @default(0) // 0-10 중요도 (AI 평가)

  createdAt   DateTime @default(now())

  @@unique([date, category, title])
  @@index([date])
  @@index([date, category])
}

// Tomorrow Signal - Daily Report (4-step pipeline output)
model SignalReport {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  mode        String   @default("standard") // "standard" | "daytrader"
  step        Int      // 1=뉴스수집, 2=지표분석, 3=투자자분석, 4=칼럼

  // Step 1: 글로벌 뉴스 수집 결과
  newsData    Json?    // 10개 지역 기사 + 실시간 이슈 20개

  // Step 2: 경제 지표 + 투자 심리
  indicators  Json?    // 일/주/월/분기 지표 + 공포/탐욕/지루함 지수

  // Step 3: 6명 투자자 관점 분석
  analysis    Json?    // 투자자별 분석 결과

  // Step 4: 최종 칼럼
  column      String?  // 마크다운 칼럼 본문 (10,000~20,000자)
  columnTitle String?  // 칼럼 제목

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, mode])
  @@index([date])
}

// M10: Money Flow (가계부)
model MoneyTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // 'income' | 'expense'
  category  String   // e.g., 'salary', 'food', 'transport'
  amount    Int      // Amount in smallest unit (e.g., cents, won)
  memo      String?
  date      String   // YYYY-MM-DD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
}